# Development defaults. All real values belong in .env.local or hosting secrets.
CONTENT_PROVIDER=mock
SITE_URL=http://localhost:3000
SITE_NAME=NotionBlog
# Profile, avatar and social links: ignored local file, or the same JSON as a hosting secret.
SITE_CONFIG=config/site.json
SITE_CONFIG_JSON=
NOTION_TOKEN=
NOTION_API_VERSION=2026-03-11
NOTION_SOURCES_CONFIG=.local/notion-sources.json
# Optional hosting alternative to the ignored local JSON file; keep real JSON private.
NOTION_SOURCES_JSON=
# Optional separate signing key. If empty, the server uses NOTION_TOKEN.
MEDIA_SIGNING_SECRET=
# Optional database provider. Website uses a restricted nb_reader LOGIN, never migration/writer credentials.
DATABASE_READER_URL=
DATABASE_TLS=verify
DATABASE_CA_CERT=
# Independent v2 reader extension; keep legacy until its migration/digest is installed and verified.
DATABASE_READ_PROJECTION=legacy
# Independent image source when CONTENT_PROVIDER=database: storage (legacy) or notion.
# notion needs the private server NOTION_TOKEN and the same NOTION_SOURCES_JSON/config.
# Install the media-source extension and publish a fresh SYNC_MEDIA_PROVIDER=notion run first.
MEDIA_PROVIDER=storage
# Optional previews with database + notion media. Install the independent thumbnail migration,
# generate/register previews for the current published run, then opt in server-side.
MEDIA_THUMBNAILS=disabled
# Default fresh Notion checks. Database-only v2 thumbnail eligibility requires an explicit publication-policy decision.
MEDIA_THUMBNAIL_QUALIFICATION=live-notion
# Optional independent object backend. Supabase remains the default.
STORAGE_PROVIDER=supabase
# Optional: qualified v2 thumbnails only; omitted inherits STORAGE_PROVIDER.
# THUMBNAIL_STORAGE_PROVIDER=cos
# COS is opt-in and uses a dedicated namespace in an operator-verified private bucket.
# Reader and writer receive separate scoped server credentials. Never use NEXT_PUBLIC_.
COS_BUCKET=
COS_REGION=
# Optional website-only COS GET transport. Default fetch; validate in protected preview before changing production.
COS_READ_TRANSPORT=fetch
# Reader-only acceleration; requires separate bucket enablement and paid-service approval.
COS_READ_ENDPOINT=regional
COS_PREFIX=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SECURITY_TOKEN=
# Temporary credentials require their expiry as Unix seconds. Empty means a scoped long-lived key.
COS_CREDENTIALS_EXPIRES_AT=
# Private storage, using a scoped authenticated JWT (app_metadata.notionblog_storage_role=reader).
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_API_KEY=
STORAGE_READ_TOKEN=
# Optional automatic reader access-token renewal; configure all three together.
# Dedicated reader Auth user only. Never use worker credentials or NEXT_PUBLIC_ variables.
# If omitted, STORAGE_READ_TOKEN is used. Password sessions must allow concurrent servers.
STORAGE_READER_EMAIL=
STORAGE_READER_PASSWORD=
STORAGE_READER_USER_ID=
# Optional website v2 schema; v1 remains the default for the existing worker.
DATABASE_CONTENT_VERSION=1
# Optional persistent publication extension; qualified preserves the existing expiry.
# published requires v2, installed publication migration, explicit fresh activation,
# and independent stored originals (MEDIA_PROVIDER=storage).
DATABASE_PUBLICATION_MODE=qualified
# Public boolean switches only, e.g. {"game":true,"book":true,"movie":true,"album":true,"post":true,"page":true}
CONTENT_FEATURES_JSON=
# Search indexing remains disabled until the owner authorizes a public launch.
SITE_INDEXING_ENABLED=false
# Limit discoverable routes to pages actually implemented by the frontend.
SITE_DISCOVERY_KINDS_JSON=["status","course","study-note"]
# Social timeline v2: trial (default) or retained after its reviewed-projection migration and scope installation.
# This does not enable SOCIAL_PROVIDER, approve sources, or change the legacy v1 endpoint.
SOCIAL_DISPLAY_MODE=trial
# Optional social covers: enable only after independent SQL/storage installation and acceptance.
# Storage credentials use a separate SOCIAL_MEDIA_STORAGE_* / SOCIAL_MEDIA_COS_* server profile.
SOCIAL_MEDIA_ENABLED=false
