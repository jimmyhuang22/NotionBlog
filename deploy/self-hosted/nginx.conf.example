# Included from nginx's http context. Keep an existing service on 443 intact.
# Cloudflare must use Full (strict), with an Origin Rule overriding the
# destination port to 8443. Restrict this port to Cloudflare's current ranges.
log_format notionblog '$realip_remote_addr [$time_local] "$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent';

server {
    listen 8443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    server_name blog.example.invalid www.blog.example.invalid;
    ssl_certificate /etc/notionblog/tls/origin.pem;
    ssl_certificate_key /etc/notionblog/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # Refresh these networks from https://www.cloudflare.com/ips/ at installation.
    # Accept the visitor address only from Cloudflare edge peers.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    client_max_body_size 1m;
    access_log /var/log/nginx/notionblog-access.log notionblog;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 65s;
    }
}
