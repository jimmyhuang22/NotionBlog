# Copy into a private mode-600 file. Paths must be absolute and canonical.
NOTION_TOKEN=
NOTION_API_VERSION=2026-03-11
NOTION_SOURCES_CONFIG=
# Alternative to NOTION_SOURCES_CONFIG; never set both.
NOTION_SOURCES_JSON=
SYNC_DATABASE_URL=
DATABASE_TLS=verify
DATABASE_CA_CERT=
STORAGE_URL=
STORAGE_BUCKET=notionblog-media
STORAGE_API_KEY=
STORAGE_WRITE_TOKEN=
SYNC_STATE_DIR=
SYNC_MODE=dry-run
# Hybrid source index + converted-image uploads only; install migrate-media first.
# storage preserves legacy uploads. Website selects its source with MEDIA_PROVIDER.
SYNC_MEDIA_PROVIDER=storage

# Optional reviewed local HEIC -> JPEG binary, compiled once on macOS.
SYNC_HEIC_CONVERTER_PATH=

# Optional image budget: default 20000ms, hard maximum 60000ms.
SYNC_IMAGE_TIMEOUT_MS=
# Response-header budget per address, default 5000ms; at most two addresses.
SYNC_IMAGE_HEADER_TIMEOUT_MS=
# Optional descriptive bot identity with a public contact URL. Omit if unused.
# Do not put tokens, private URLs or other credentials in this public HTTP header.
# SYNC_IMAGE_USER_AGENT=ExampleSyncBot/1.0 (https://example.test/contact)
